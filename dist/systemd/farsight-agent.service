# Farsight agent: shares your desktop session (ADR-0009, U-6).
# Installed as a *user* unit and NOT enabled automatically. The easy way to
# turn it on is the "Farsight Sharing" app; from a terminal:
#   systemctl --user enable --now farsight-agent
# Defaults come from ~/.config/farsight/agent/settings (written by Farsight
# Sharing: `listen = lan`, `announce = yes`, `view-only = no`); options
# added to ExecStart with `systemctl --user edit` win over that file.
[Unit]
Description=Farsight desktop sharing agent
Documentation=https://github.com/rhonaldjr/ptom
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/farsight-agent
# `systemctl --user reload` re-reads passwords set with farsight-passwd.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
# Slow and limited restarts: each start may show the desktop's sharing
# dialog, so a failing agent must not loop (Farsight Sharing shows why).
RestartSec=30

# Hardening (ADR-0009). The agent runs as you and needs your session's
# D-Bus, Wayland/X11 sockets and PipeWire, so home stays readable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Only the agent's own files are writable (not its credentials, not the viewer's vault).
# The leading '-' keeps the unit working before the directory exists.
ReadWritePaths=-%h/.config/farsight/agent -%t/farsight
# No PrivateTmp: the X11 backend needs /tmp/.X11-unix.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=graphical-session.target
